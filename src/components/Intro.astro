---
import Button from '@/components/Button'
import { Image } from 'astro:assets'
import 1-95680e92 from '1-95680e92.png'
import WordRotate from './WordRotate.astro'
const words = ['innovative', 'efficient', 'practical', 'collaborative']
---

<style>
	@import url('https://cdn.jsdelivr.net/gh/dheereshagrwal/colored-icons@1.7.3/src/app/ci.min.css');
</style>
<div class='flex flex-row justify-between md:mt-0 space-x-4 lg:space-x-6'>
	<div class='flex flex-col justify-between space-y-4'>
		<div
			class='flex flex-col justify-between m-0 font-light text-md lg:text-xl'
		>
			<div>
				Hi, I'm <span class='font-bold text-fuchsia-600'>Rohan Gandhi</span>,
				currently studying in Simon Fraser University located in Vancouver, Canada. I am currrently in my second year hoping to specialize in cyber security and get more exposure 
				to the software systems within mechatronics.
			</div>

			<div class='mt-2'>
				<WordRotate
					words={words}
					prefix='I like to find solutions that are'
					class='text-md lg:text-xl'
					duration={1308}
				/>
			</div>
		</div>
	</div>
	<!-- <div class='h-full lg:w-[300px] md:hidden lg:block'>
		<Image
			src={1-95680e92}
			width={200}
			height={200}
			quality={100}
			format='png'
			loading='eager'
			class='bg-blue-400 dark:bg-slate-300 rounded-md w-auto max-h-[200px] md:max-h-[150px] object-contain'
			alt={`Rohan Gandhi avatar`}
		/>
	</div> -->
	<div class='h-full lg:w-[300px] md:hidden lg:block'>
		<Image
			src={1-95680e92}
			width={200}
			height={200}
			quality={100}
			format='png'
			loading='eager'
			class='bg-blue-400 dark:bg-slate-300 rounded-md w-auto max-h-[200px] md:max-h-[150px] object-contain'
			alt={`Rohan Gandhi avatar`}
		/>
	</div>
</div>

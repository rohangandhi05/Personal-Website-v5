---
import type { CollectionEntry } from 'astro:content'
import PostCard from '@/components/PostCard'

type Props = {
	posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props

const postsWithReadTime = await Promise.all(
	posts.map(async (post) => {
		const { remarkPluginFrontmatter } = await post.render()
		return { post, readTime: remarkPluginFrontmatter.minutesRead as string }
	})
)
---

<section class='flex flex-col divide-y divide-zinc-200 dark:divide-zinc-800'>
	{
		postsWithReadTime.map(({ post, readTime }, i) => (
			<PostCard
				id={post.id}
				data={post.data}
				slug={post.slug}
				readTime={readTime}
				featured={i === 0}
			/>
		))
	}
</section>

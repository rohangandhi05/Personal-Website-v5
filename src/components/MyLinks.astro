---
import Button from './Button.astro'
import HeaderLink from './HeaderLink.astro'
import Calender from './icons/Calender.astro'
import Email from './icons/Email.astro'
import GithubIcon from './icons/GithubIcon.astro'
import Linkedin from './icons/Linkedin.astro'

---

<div class='flex flex-col space-y-2'>
	<h2 class='text-xl font-bold m-0'>Links</h2>

	<ul class='flex flex-col space-y-2'>
		<li>
			<HeaderLink
				href='https://github.com/rohangandhi05'
				class='flex items-center gap-1 text-md md:text-base hover:text-fuchsia-500'
			>
				<GithubIcon /> GitHub
			</HeaderLink>
		</li>
		<li>
			<HeaderLink
				href='https://www.linkedin.com/in/rohan-g05/'
				class='flex items-center gap-1 text-md md:text-base hover:text-fuchsia-500'
			>
				<Linkedin /> LinkedIn
			</HeaderLink>
		</li>
		<li>
			<HeaderLink
				href='mailto:gandhirohan05@gmail.com'
				class='flex items-center gap-1 text-md md:text-base hover:text-fuchsia-500'
			>
				<Email /> Email
			</HeaderLink>
		</li>
		<li>
			<HeaderLink
				href='https://cal.com/rohanxg/30min'
				class='flex items-center gap-1 text-md md:text-base hover:text-fuchsia-500'
			>
				<Calender /> Cal.com
			</HeaderLink>
		</li>

	</ul>
	<div class='flex flex-row space-x-3'>
		<Button class='text-md' href='https://cal.com/rohanxg/30min'>
			Chat with me
		</Button>
	</div>
</div>

---
import { Image } from 'astro:assets'
import FormattedDate from '@/components/FormattedDate'
import ArrowUp from '@/components/icons/ArrowUp'

const {
	id,
	data: { title, description, pubDate, heroImage, category },
	readTime,
	slug,
	size = 'medium'
} = Astro.props
---

{
	size === 'featured' && (
		<article class='group w-full'>
			<a href={`/post/${slug}/`} class='block overflow-hidden rounded-sm'>
				<Image
					src={heroImage}
					width={1200}
					height={500}
					format='webp'
					class='w-full h-[320px] md:h-[420px] object-cover group-hover:scale-[101%] transition-transform duration-300 rounded-sm'
					alt={`img of ${title}`}
				/>
			</a>
			<div class='mt-5 space-y-3'>
				<div class='flex items-center gap-2'>
					<span class='text-xs font-semibold uppercase tracking-wider text-fuchsia-500'>
						{category}
					</span>
					<span class='text-xs text-gray-400'>•</span>
					<span class='text-xs text-gray-400'>{readTime}</span>
				</div>
				<a href={`/post/${slug}/`}>
					<h2 class='text-4xl md:text-5xl font-bold tracking-tight leading-tight mt-1 hover:text-fuchsia-500 transition-colors'>
						{title}
					</h2>
				</a>
				<p class='text-sm text-gray-500 dark:text-gray-400 line-clamp-2 max-w-2xl'>
					{description}
				</p>
				<div class='flex items-center justify-between pt-1'>
					<FormattedDate date={pubDate} />
					<a
						href={`/post/${slug}/`}
						class='flex items-center gap-1 text-sm font-semibold hover:text-fuchsia-500 transition-colors group/link'
						aria-label={`go to ${title}`}
					>
						Read Story{' '}
						<span class='mt-[1px] group-hover/link:rotate-45 transition-transform duration-200'>
							<ArrowUp width='16' height='16' />
						</span>
					</a>
				</div>
			</div>
		</article>
	)
}

{
	size === 'medium' && (
		<article class='group flex flex-col'>
			<a href={`/post/${slug}/`} class='block overflow-hidden rounded-sm'>
				<Image
					src={heroImage}
					width={600}
					height={250}
					format='webp'
					class='w-full h-[220px] object-cover group-hover:scale-[101%] transition-transform duration-300 rounded-sm'
					alt={`img of ${title}`}
				/>
			</a>
			<div class='mt-4 flex flex-col gap-2 flex-1'>
				<span class='text-xs font-semibold uppercase tracking-wider text-fuchsia-500'>
					{category}
				</span>
				<a href={`/post/${slug}/`}>
					<h3 class='text-2xl font-bold tracking-tight leading-snug hover:text-fuchsia-500 transition-colors'>
						{title}
					</h3>
				</a>
				<p class='text-sm text-gray-500 dark:text-gray-400 line-clamp-2'>
					{description}
				</p>
				<div class='flex items-center gap-2 text-xs text-gray-400 mt-auto pt-2'>
					<FormattedDate date={pubDate} />
					<span>•</span>
					<span>{readTime}</span>
				</div>
			</div>
		</article>
	)
}

{
	size === 'small' && (
		<article class='group py-4'>
			<div class='flex flex-col gap-2'>
				<span class='text-xs font-semibold uppercase tracking-wider text-fuchsia-500'>
					{category}
				</span>
				<a href={`/post/${slug}/`}>
					<h3 class='text-xl font-bold tracking-tight leading-snug group-hover:text-fuchsia-500 transition-colors'>
						{title}
					</h3>
				</a>
				<p class='text-sm text-gray-500 dark:text-gray-400 line-clamp-2'>
					{description}
				</p>
				<div class='flex items-center gap-2 text-xs text-gray-400'>
					<FormattedDate date={pubDate} />
					<span>•</span>
					<span>{readTime}</span>
				</div>
			</div>
		</article>
	)
}

---
import { Image } from 'astro:assets'
import FormattedDate from '@/components/FormattedDate'
import ArrowUp from '@/components/icons/ArrowUp'

const {
	id,
	data: { title, description, pubDate, heroImage, category },
	readTime,
	slug,
	featured = false
} = Astro.props
---

<article class={`group py-5 ${featured ? 'pb-6' : ''}`}>
	<a href={`/post/${slug}/`} class='block overflow-hidden rounded-2xl mb-3'>
		<Image
			src={heroImage}
			width={800}
			height={featured ? 150 : 120}
			format='webp'
			class={`w-full object-cover group-hover:scale-[101%] transition-transform duration-300 rounded-2xl ${featured ? 'h-36 md:h-40' : 'h-28'}`}
			alt={`img of ${title}`}
		/>
	</a>

	<div class='flex flex-col gap-1.5'>
		<div class='flex items-center gap-2'>
			<span
				class='text-xs font-semibold uppercase tracking-wider text-fuchsia-500'
			>
				{category}
			</span>
			<span class='text-xs text-gray-400'>•</span>
			<span class='text-xs text-gray-400'>{readTime}</span>
		</div>

		<a href={`/post/${slug}/`}>
			<h2
				class={`font-bold tracking-tight leading-snug hover:text-fuchsia-500 transition-colors ${featured ? 'text-xl' : 'text-base'}`}
			>
				{title}
			</h2>
		</a>

		<p class='text-sm text-gray-500 dark:text-gray-400 line-clamp-2'>
			{description}
		</p>

		<div class='flex items-center justify-between pt-0.5'>
			<FormattedDate date={pubDate} />
			{
				featured && (
					<a
						href={`/post/${slug}/`}
						class='flex items-center gap-1 text-sm font-semibold hover:text-fuchsia-500 transition-colors group/link'
						aria-label={`go to ${title}`}
					>
						Read Story{' '}
						<span class='mt-[1px] group-hover/link:rotate-45 transition-transform duration-200'>
							<ArrowUp width='16' height='16' />
						</span>
					</a>
				)
			}
		</div>
	</div>
</article>

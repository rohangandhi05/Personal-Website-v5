<div class='flex flex-col space-y-1'>
	<h2 class='text-xl font-bold m-0'>{new Date().getFullYear()} Goals</h2>
	<div class='flex justify-between space-x-2 items-center mb-4'>
		<div>
			<input disabled type='checkbox' id='marathon' name='marathon' value='marathon' />
			<label class='text-sm' for='marathon'>Run a marathon</label><br />
		</div>
	</div>
	<div class='flex justify-between space-x-2 items-center mb-4'>
		<div>
			<input disabled type='checkbox' id='books' name='books' value='books' />
			<label class='text-sm' for='books'>Read 5 books</label><br />
		</div>
	</div>
	<div class='flex justify-between space-x-2 items-center mb-4'>
		<div>
			<input disabled type='checkbox' id='backflip' name='backflip' value='backflip' />
			<label class='text-sm' for='backflip'>Do a backflip</label><br />
		</div>
	</div>
	<div class='flex justify-between space-x-2 items-center mb-4'>
		<div>
			<input disabled type='checkbox' id='bench' name='bench' value='bench' />
			<label class='text-sm' for='bench'>Bench 2 plates</label><br />
		</div>
	</div>
</div>

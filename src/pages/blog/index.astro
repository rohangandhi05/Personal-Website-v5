---
import ListPosts from '@/components/ListPosts'
import BaseLayout from '@/layouts/BaseLayout'
import { getPosts, getTags, sluglify } from '@/utils'

const posts = await getPosts()
const tags = await getTags()
---

<BaseLayout title='Blog'>
	<div class='flex flex-wrap gap-2 mb-8'>
		<a
			href='/blog'
			class='px-3 py-1 text-sm font-medium rounded-full bg-fuchsia-500 text-white border border-fuchsia-500'
		>
			All
		</a>
		{
			tags.map((tag) => (
				<a
					href={`/tags/${sluglify(tag)}`}
					class='px-3 py-1 text-sm font-medium rounded-full border border-zinc-300 dark:border-zinc-700 hover:border-fuchsia-500 hover:text-fuchsia-500 transition-colors'
				>
					{tag}
				</a>
			))
		}
	</div>

	<ListPosts posts={posts} />
</BaseLayout>

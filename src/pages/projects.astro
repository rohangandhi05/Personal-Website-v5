---
import BaseLayout from '@/layouts/BaseLayout'

const projects = [
	{
		name: 'Vedic Hindi School App',
		url: 'https://github.com/rohangandhi05/SchoolApp',
		page: '/projects/vedic-hindi-school/',
		summary:
			'A React Native app and admin dashboard on one Firebase backend that runs a Sunday Hindi school: sign-up by one-time ID, attendance, announcements and push notifications. 300+ installs.'
	},
	{
		name: 'Tesla Telemetry (Android)',
		url: 'https://github.com/rohangandhi05/tesla-telemetry-android',
		summary:
			'An Android app that pulls live telemetry from a Tesla vehicle and displays real-time data such as battery, charging, location, and driving stats.'
	},
	{
		name: 'In-Game Chess Analyzer',
		url: 'https://github.com/rohangandhi05/In-Game-Chess-Analyzer',
		page: '/projects/chess-analyzer/',
		summary:
			'A tool that evaluates chess positions and moves in real time during a game, surfacing analysis to help you understand the current position and find stronger continuations.'
	},
	{
		name: '3D Tic Tac Toe',
		url: 'https://github.com/rohangandhi05/3DTicTacToe',
		summary:
			'A three-dimensional spin on classic tic-tac-toe, played across a 3D grid that adds an extra layer of spatial strategy to the game.'
	},
	{
		name: 'Magic Mirror',
		url: 'https://github.com/rohangandhi05/MagicMirror',
		page: '/projects/magic-mirror/',
		summary:
			'A smart mirror built on Raspberry Pi OS that displays useful information — like the time, weather, and daily updates — behind a reflective surface.'
	}
]
---

<BaseLayout title='Projects'>
	<h1 class='page-title' style='text-align: left;'>Projects</h1>

	<ul class='project-list'>
		{
			projects.map((project) => (
				<li>
					<span class='project-trigger'>
						<a
							class='project-link'
							href={project.page ?? project.url}
							target={project.page ? undefined : '_blank'}
							rel={project.page ? undefined : 'noopener noreferrer'}
						>
							{project.name}
						</a>
						<span class='project-popup' role='tooltip'>
							{project.summary}
						</span>
					</span>
				</li>
			))
		}
	</ul>
</BaseLayout>

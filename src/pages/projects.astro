---
import BaseLayout from '@/layouts/BaseLayout'

const projects = [
	{
		name: 'In-Game Chess Analyzer',
		url: 'https://github.com/rohangandhi05/In-Game-Chess-Analyzer',
		summary:
			'A tool that evaluates chess positions and moves in real time during a game, surfacing analysis to help you understand the current position and find stronger continuations.'
	},
	{
		name: '3D Tic Tac Toe',
		url: 'https://github.com/rohangandhi05/3DTicTacToe',
		summary:
			'A three-dimensional spin on classic tic-tac-toe, played across a 3D grid that adds an extra layer of spatial strategy to the game.'
	},
	{
		name: 'Magic Mirror',
		url: 'https://github.com/rohangandhi05/MagicMirror',
		summary:
			'A smart mirror built on Raspberry Pi OS that displays useful information — like the time, weather, and daily updates — behind a reflective surface.'
	},
	{
		name: 'Premier League Data Scraper',
		url: 'https://github.com/rohangandhi05/DataScraping',
		summary:
			'Scrapes and organizes Premier League match data into a structured, analysis-ready format for exploring stats and trends across the season.'
	}
]
---

<BaseLayout title='Projects'>
	<h1 class='page-title' style='text-align: left;'>Projects</h1>

	<ul class='project-list'>
		{
			projects.map((project) => (
				<li>
					<span class='project-trigger'>
						<a
							class='project-link'
							href={project.url}
							target='_blank'
							rel='noopener noreferrer'
						>
							{project.name}
						</a>
						<span class='project-popup' role='tooltip'>
							{project.summary}
						</span>
					</span>
				</li>
			))
		}
	</ul>
</BaseLayout>

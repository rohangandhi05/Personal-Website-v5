---
import { render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout'
import { getSnippets } from '@/utils'

// Wire-style dateline, e.g. "Nov 21, 2026 —", in local time
const dateline = (date: Date) =>
	date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		timeZone: 'America/Vancouver'
	})

const snippets = await Promise.all(
	(await getSnippets()).map(async (snippet) => ({
		...snippet,
		Content: (await render(snippet)).Content
	}))
)

// Filter chips in a fixed order, then any other tags alphabetically
const SECTORS = [
	'AI',
	'Big Tech',
	'Chips & Compute',
	'Software',
	'Fintech',
	'Finance & VC',
	'Consumer',
	'Media & Gaming',
	'Health',
	'Robotics',
	'Defense',
	'Space & Aviation',
	'Energy',
	'Industrials'
]
const used = new Set(snippets.flatMap((s) => s.data.tags))
const sectors = [
	...SECTORS.filter((tag) => used.has(tag)),
	...[...used].filter((tag) => !SECTORS.includes(tag)).sort()
]
---

<BaseLayout
	title='Snippets'
	description='Short pieces of writing, shorter than a blog post.'
	showFooter={false}
>
	<Fragment slot='head'>
		<link
			href='https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap'
			rel='stylesheet'
		/>
	</Fragment>

	<div class='masthead'>
		<h1 class='page-title'>Snippets</h1>
	</div>

	<div class='toolbar' id='toolbar' hidden>
		<label class='search'>
			<span class='visually-hidden'>Search snippets</span>
			<input
				id='snippet-search'
				type='search'
				placeholder='Search snippets'
				autocomplete='off'
				spellcheck='false'
			/>
			<kbd aria-hidden='true'>/</kbd>
		</label>
		{
			sectors.length > 0 && (
				<div
					class='chips'
					id='chips'
					role='group'
					aria-label='Filter by sector'
				>
					<button
						class='chip is-active'
						type='button'
						data-tag='*'
						aria-pressed='true'
					>
						All
					</button>
					{sectors.map((tag) => (
						<button
							class='chip'
							type='button'
							data-tag={tag}
							aria-pressed='false'
						>
							{tag}
						</button>
					))}
				</div>
			)
		}
	</div>

	<p class='search-status' id='search-status' aria-live='polite' hidden></p>

	{snippets.length === 0 && <p class='no-results'>Nothing here yet.</p>}

	{
		snippets.map(({ id, data, Content }) => (
			<article class='snippet' id={id} data-tags={data.tags.join('|')}>
				{(data.company || data.draft) && (
					<p class='kicker'>
						{data.draft && <span class='draft-badge'>Draft</span>}
						{data.company}
					</p>
				)}
				{data.title && <h2>{data.title}</h2>}
				<div class='post-content'>
					<span class='dateline'>
						<a href={`#${id}`} title='Link to this snippet'>
							<time datetime={data.pubDate.toISOString()}>
								{dateline(data.pubDate)}
							</time>
						</a>{' '}
						—
					</span>
					<Content />
				</div>
				{data.image && (
					<figure class='snippet-image'>
						<img
							src={data.image}
							alt={data.imageAlt ?? ''}
							loading='lazy'
							decoding='async'
						/>
					</figure>
				)}
				<button
					class='snippet-toggle'
					type='button'
					aria-expanded='false'
					hidden
				>
					Continue reading
				</button>
			</article>
		))
	}

	<button class='load-more' id='load-more' type='button' hidden>
		More snippets
	</button>

	<button
		class='back-to-top'
		id='back-to-top'
		type='button'
		aria-label='Back to top'
		tabindex='-1'
	>
		↑
	</button>

	<div
		class='ticker'
		id='ticker'
		role='region'
		aria-label='Market ticker, quotes delayed'
	>
		<div class='ticker-viewport'>
			<div class='ticker-track' id='ticker-track'></div>
		</div>
	</div>

	<script is:inline>
		;(() => {
			const PAGE = 20
			const reduceMotion = matchMedia(
				'(prefers-reduced-motion: reduce)'
			).matches
			const snippets = [...document.querySelectorAll('.snippet')]
			const toolbar = document.getElementById('toolbar')
			const input = document.getElementById('snippet-search')
			const chips = document.getElementById('chips')
			const status = document.getElementById('search-status')
			const loadMore = document.getElementById('load-more')
			const backToTop = document.getElementById('back-to-top')

			// ---------- Collapse long snippets to a preview ----------
			const setOpen = (snippet, open) => {
				snippet.classList.toggle('is-collapsed', !open)
				const toggle = snippet.querySelector('.snippet-toggle')
				toggle.setAttribute('aria-expanded', String(open))
				toggle.textContent = open ? 'Show less' : 'Continue reading'
			}

			for (const snippet of snippets) {
				const content = snippet.querySelector('.post-content')
				const toggle = snippet.querySelector('.snippet-toggle')
				snippet.classList.add('is-collapsed')
				// Short snippets fit in the preview, so leave them as they are
				if (content.scrollHeight <= content.clientHeight + 8) {
					snippet.classList.remove('is-collapsed')
					continue
				}
				toggle.hidden = false
				toggle.addEventListener('click', () => {
					const open = snippet.classList.contains('is-collapsed')
					setOpen(snippet, open)
					if (!open) snippet.scrollIntoView({ block: 'nearest' })
				})
				content.addEventListener('click', (e) => {
					if (
						snippet.classList.contains('is-collapsed') &&
						!e.target.closest('a')
					)
						setOpen(snippet, true)
				})
			}

			// ---------- Search highlighting ----------
			const searchable = (snippet) =>
				snippet.querySelectorAll('.kicker, h2, .post-content')

			const clearMarks = (snippet) => {
				for (const mark of snippet.querySelectorAll('mark.hit'))
					mark.replaceWith(mark.textContent)
				snippet.normalize()
			}

			const markMatches = (root, query) => {
				const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
				const nodes = []
				while (walker.nextNode()) nodes.push(walker.currentNode)
				for (const node of nodes) {
					const text = node.nodeValue
					const lower = text.toLowerCase()
					let i = lower.indexOf(query)
					if (i === -1) continue
					const frag = document.createDocumentFragment()
					let last = 0
					while (i !== -1) {
						frag.append(text.slice(last, i))
						const mark = document.createElement('mark')
						mark.className = 'hit'
						mark.textContent = text.slice(i, i + query.length)
						frag.append(mark)
						last = i + query.length
						i = lower.indexOf(query, last)
					}
					frag.append(text.slice(last))
					node.replaceWith(frag)
				}
			}

			// ---------- Filtering, search and paging in one pass ----------
			const state = { raw: '', tag: '*', limit: PAGE }

			const apply = () => {
				const query = state.raw.toLowerCase()
				const { tag } = state
				const filtering = Boolean(query) || tag !== '*'
				let shown = 0

				snippets.forEach((snippet, i) => {
					clearMarks(snippet)
					const parts = searchable(snippet)
					const tags = (snippet.dataset.tags || '').split('|')
					const match =
						(tag === '*' || tags.includes(tag)) &&
						(!query ||
							[...parts].some((el) =>
								el.textContent.toLowerCase().includes(query)
							))
					// Paging only applies to the unfiltered stream
					const visible = match && (filtering || i < state.limit)
					snippet.classList.toggle('is-hidden', !visible)
					if (match) shown++

					if (query && match) {
						parts.forEach((el) => markMatches(el, query))
						// Open collapsed matches so the hits are visible
						if (snippet.classList.contains('is-collapsed')) {
							snippet.dataset.autoOpen = ''
							setOpen(snippet, true)
						}
					} else if (!query && 'autoOpen' in snippet.dataset) {
						delete snippet.dataset.autoOpen
						setOpen(snippet, false)
					}
				})

				loadMore.hidden = filtering || state.limit >= snippets.length

				const noun = shown === 1 ? 'snippet' : 'snippets'
				const inTag = tag === '*' ? '' : ` in ${tag}`
				status.hidden = !filtering
				status.textContent = query
					? shown === 0
						? `No snippets${inTag} mention “${state.raw}”`
						: `${shown} ${noun}${inTag} ${shown === 1 ? 'mentions' : 'mention'} “${state.raw}”`
					: `${shown} ${noun}${inTag}`
			}

			// If the toolbar is stuck to the top, jump back to the start of the list
			const scrollToList = () => {
				const top =
					status.getBoundingClientRect().top +
					window.scrollY -
					toolbar.offsetHeight -
					8
				if (window.scrollY > top) window.scrollTo({ top })
			}

			let timer
			input.addEventListener('input', () => {
				clearTimeout(timer)
				timer = setTimeout(() => {
					state.raw = input.value.trim()
					apply()
					scrollToList()
				}, 120)
			})
			input.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					input.value = ''
					state.raw = ''
					apply()
					input.blur()
				}
			})
			// Press / anywhere to jump to search
			document.addEventListener('keydown', (e) => {
				if (e.key === '/' && document.activeElement !== input) {
					e.preventDefault()
					input.focus()
				}
			})

			chips?.addEventListener('click', (e) => {
				const chip = e.target.closest('.chip')
				if (!chip) return
				state.tag = chip.dataset.tag
				for (const c of chips.querySelectorAll('.chip')) {
					const active = c === chip
					c.classList.toggle('is-active', active)
					c.setAttribute('aria-pressed', String(active))
				}
				apply()
				scrollToList()
			})

			// ---------- Load more, by button or automatically near the end ----------
			const showMore = () => {
				state.limit += PAGE
				apply()
				// Re-observe so a still-visible button keeps loading
				autoLoad.unobserve(loadMore)
				autoLoad.observe(loadMore)
			}
			loadMore.addEventListener('click', showMore)
			const autoLoad = new IntersectionObserver(
				(entries) => {
					if (entries.some((e) => e.isIntersecting) && !loadMore.hidden)
						showMore()
				},
				{ rootMargin: '0px 0px 600px 0px' }
			)
			autoLoad.observe(loadMore)

			// ---------- Shared links open (and reveal) their snippet ----------
			const openTarget = () => {
				const target =
					location.hash && document.getElementById(location.hash.slice(1))
				if (!target || !target.classList.contains('snippet')) return
				const index = snippets.indexOf(target)
				if (index >= state.limit) {
					state.limit = Math.ceil((index + 1) / PAGE) * PAGE
					apply()
				}
				if (target.classList.contains('is-collapsed')) setOpen(target, true)
				target.classList.add('is-in')
				target.scrollIntoView()
			}

			// ---------- Fade snippets in as they scroll into view ----------
			if (!reduceMotion && 'IntersectionObserver' in window) {
				document.documentElement.classList.add('reveal')
				const reveal = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue
							entry.target.classList.add('is-in')
							reveal.unobserve(entry.target)
						}
					},
					{ rootMargin: '0px 0px -6% 0px' }
				)
				snippets.forEach((s) => reveal.observe(s))
			}

			// ---------- Back to top ----------
			let ticking = false
			const updateBackToTop = () => {
				const shown = window.scrollY > window.innerHeight * 1.5
				backToTop.classList.toggle('is-shown', shown)
				backToTop.tabIndex = shown ? 0 : -1
				ticking = false
			}
			window.addEventListener(
				'scroll',
				() => {
					if (ticking) return
					ticking = true
					requestAnimationFrame(updateBackToTop)
				},
				{ passive: true }
			)
			backToTop.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' })
				input.focus({ preventScroll: true })
			})

			toolbar.hidden = false
			apply()
			if (location.hash) openTarget()
			window.addEventListener('hashchange', openTarget)
		})()
		;(async () => {
			const ticker = document.getElementById('ticker')
			const track = document.getElementById('ticker-track')
			try {
				const res = await fetch('/api/quotes')
				const { quotes } = await res.json()
				if (!res.ok || !quotes.length) throw new Error('no quotes')

				const group = document.createElement('div')
				group.className = 'ticker-group'
				for (const q of quotes) {
					const up = q.change >= 0
					const item = document.createElement('span')
					item.className = 'ticker-item'

					const label = document.createElement('b')
					label.textContent = q.label
					const price = document.createElement('span')
					price.textContent = q.price.toLocaleString('en-US', {
						minimumFractionDigits: 2,
						maximumFractionDigits: 2
					})
					const change = document.createElement('span')
					change.className = up ? 'up' : 'down'
					change.textContent = `${up ? '▲' : '▼'} ${Math.abs(q.change).toFixed(2)}%`

					item.append(label, price, change)
					group.append(item)
				}

				// Two identical groups so the loop scrolls seamlessly
				const copy = group.cloneNode(true)
				copy.setAttribute('aria-hidden', 'true')
				track.replaceChildren(group, copy)
				track.style.setProperty('--duration', `${quotes.length * 5}s`)
				track.classList.add('is-running')
			} catch {
				ticker.remove()
			}
		})()
	</script>
</BaseLayout>

<style>
	/* ---------- Salmon paper tint, this page only ---------- */
	:global(html:has(.masthead)) {
		--bg-color: #fff1e5;
		--border-color: #ecd8c4;
	}

	:global(html[data-theme='dark']:has(.masthead)) {
		--bg-color: #1f1a17;
		--border-color: #3b322b;
	}

	/* ---------- Masthead: plain title, matching Blog and Projects ---------- */
	.masthead .page-title {
		margin-bottom: 0;
		text-align: left;
	}

	/* ---------- Sticky toolbar: search plus sector chips ---------- */
	.toolbar {
		position: sticky;
		top: 0;
		z-index: 5;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin: 0 0 1.5rem;
		padding: 0.9rem 0 0.75rem;
		background: var(--bg-color);
		border-bottom: 1px solid var(--border-color);
	}

	.toolbar[hidden] {
		display: none;
	}

	.search {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search input {
		width: 100%;
		padding: 0.3rem 1.8rem 0.3rem 0;
		border: none;
		border-radius: 0;
		background: transparent;
		font-family: 'EB Garamond', serif;
		font-size: 1.05rem;
		color: var(--heading-color);
		outline: none;
		appearance: none;
	}

	.search input::placeholder {
		font-style: italic;
		color: var(--link-hover-color);
	}

	.search input::-webkit-search-cancel-button {
		display: none;
	}

	.search kbd {
		position: absolute;
		right: 0;
		padding: 0 0.35em;
		border: 1px solid var(--border-color);
		border-radius: 3px;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		color: var(--link-hover-color);
		pointer-events: none;
	}

	.search input:focus + kbd,
	.search input:not(:placeholder-shown) + kbd {
		display: none;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* One scrollable row, so the sticky bar stays short */
	.chips {
		display: flex;
		gap: 0.4rem;
		overflow-x: auto;
		scrollbar-width: none;
		mask-image: linear-gradient(
			to right,
			#000 calc(100% - 2.5rem),
			transparent
		);
	}

	.chips::-webkit-scrollbar {
		display: none;
	}

	.chip {
		flex: none;
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--border-color);
		border-radius: 999px;
		background: transparent;
		font-family: 'EB Garamond', serif;
		font-size: 0.9rem;
		line-height: 1.2;
		white-space: nowrap;
		color: var(--link-color);
		cursor: pointer;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	.chip:hover {
		color: var(--heading-color);
		border-color: var(--link-hover-color);
	}

	.chip.is-active {
		background: var(--heading-color);
		border-color: var(--heading-color);
		color: var(--bg-color);
	}

	.chip:last-child {
		margin-right: 2rem;
	}

	.search-status {
		margin: 0 0 1.5rem;
		font-variant: small-caps;
		text-transform: lowercase;
		letter-spacing: 0.06em;
		color: var(--link-hover-color);
	}

	.snippet :global(mark.hit) {
		padding: 0 0.05em;
		border-radius: 2px;
		background: #f6cfa3;
		color: inherit;
	}

	:global([data-theme='dark']) .snippet :global(mark.hit) {
		background: #6b4a2c;
	}

	/* ---------- Snippets ---------- */
	.snippet {
		/* Clear the sticky toolbar when jumping to a snippet */
		scroll-margin-top: 8rem;
	}

	.snippet.is-hidden {
		display: none;
	}

	/* Rule between visible snippets, so filtering doesn't leave a stray line on top */
	.snippet:not(.is-hidden) ~ .snippet:not(.is-hidden) {
		margin-top: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-color);
	}

	/* Fade in on scroll (only when motion is allowed and JS is running) */
	:global(html.reveal) .snippet {
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity 0.5s ease,
			transform 0.5s ease;
	}

	:global(html.reveal) .snippet.is-in {
		opacity: 1;
		transform: none;
	}

	/* Collapsed preview: about five lines, fading out */
	.snippet.is-collapsed .post-content {
		max-height: 9em;
		overflow: hidden;
		cursor: pointer;
		mask-image: linear-gradient(to bottom, #000 45%, transparent);
	}

	/* Optional picture under the text; hidden with the rest of a collapsed snippet */
	.snippet-image {
		margin: 0.75rem 0 0;
	}

	.snippet-image img {
		display: block;
		margin: 0;
		max-width: 100%;
		max-height: 26rem;
		width: auto;
		height: auto;
		border: 1px solid var(--border-color);
		border-radius: 8px;
	}

	.snippet.is-collapsed .snippet-image {
		display: none;
	}

	.snippet-toggle {
		margin-top: 0.4rem;
		padding: 0;
		border: none;
		background: none;
		font-family: 'EB Garamond', serif;
		font-size: 0.95em;
		font-variant: small-caps;
		text-transform: lowercase;
		letter-spacing: 0.06em;
		color: var(--link-color);
		cursor: pointer;
	}

	.snippet-toggle::after {
		content: ' ↓';
	}

	.snippet-toggle[aria-expanded='true']::after {
		content: ' ↑';
	}

	.snippet-toggle:hover {
		color: var(--heading-color);
	}

	/* Section-label style company name above the headline */
	.kicker {
		margin: 0 0 0.1rem;
		font-size: 0.85em;
		font-variant: small-caps;
		text-transform: lowercase;
		letter-spacing: 0.1em;
		color: var(--link-hover-color);
	}

	/* Only visible in local dev, where drafts are shown */
	.draft-badge {
		margin-right: 0.5em;
		padding: 0 0.35em;
		border: 1px solid currentColor;
		border-radius: 3px;
		color: #b42318;
	}

	.snippet h2 {
		margin: 0 0 0.5rem;
		font-size: 1.4em;
	}

	.snippet .post-content {
		/* Contains the floated dateline */
		display: flow-root;
		/* Lining, equal-width figures, like a financial table */
		font-variant-numeric: lining-nums tabular-nums;
	}

	/* Dateline floats so the first line of text runs straight on from it */
	.dateline {
		float: left;
		margin-right: 0.35em;
		color: var(--link-hover-color);
	}

	.dateline a {
		font-variant: small-caps;
		text-transform: lowercase;
		letter-spacing: 0.06em;
		color: inherit;
		text-decoration: none;
	}

	.dateline a:hover,
	.snippet:target .dateline a {
		color: var(--heading-color);
	}

	.snippet .dateline + :global(*) {
		margin-top: 0;
	}

	/* ---------- More snippets ---------- */
	.load-more {
		display: block;
		margin: 2.5rem auto 1rem;
		padding: 0.5rem 1.25rem;
		border: 1px solid var(--border-color);
		border-radius: 999px;
		background: transparent;
		font-family: 'EB Garamond', serif;
		font-size: 1rem;
		font-variant: small-caps;
		text-transform: lowercase;
		letter-spacing: 0.08em;
		color: var(--link-color);
		cursor: pointer;
	}

	.load-more:hover {
		color: var(--heading-color);
		border-color: var(--link-hover-color);
	}

	.load-more[hidden] {
		display: none;
	}

	/* ---------- Back to top, stacked above the theme button ---------- */
	.back-to-top {
		position: fixed;
		right: 36px;
		bottom: calc(30px + 2.5rem + 72px);
		z-index: 10;
		width: 48px;
		height: 48px;
		padding: 0;
		border: 2px solid var(--border-color);
		border-radius: 50%;
		background: var(--bg-color);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
		font-size: 1.3rem;
		line-height: 1;
		color: var(--heading-color);
		cursor: pointer;
		opacity: 0;
		transform: translateY(8px);

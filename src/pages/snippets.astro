---
import { render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout'
import { getSnippets } from '@/utils'

// Wire-style dateline, e.g. "Nov 21, 2026 —", in local time
const dateline = (date: Date) =>
	date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		timeZone: 'America/Vancouver'
	})

const snippets = await Promise.all(
	(await getSnippets()).map(async (snippet) => ({
		...snippet,
		Content: (await render(snippet)).Content
	}))
)
---

<BaseLayout
	title='Snippets'
	description='Short pieces of writing, shorter than a blog post.'
	showFooter={false}
>
	<Fragment slot='head'>
		<link
			href='https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap'
			rel='stylesheet'
		/>
	</Fragment>

	<div class='masthead'>
		<h1 class='page-title'>Snippets</h1>
		<label class='search' id='search' hidden>
			<span class='visually-hidden'>Search snippets</span>
			<input
				id='snippet-search'
				type='search'
				placeholder='Search snippets'
				autocomplete='off'
				spellcheck='false'
			/>
			<kbd aria-hidden='true'>/</kbd>
		</label>
	</div>

	<p class='search-status' id='search-status' aria-live='polite' hidden></p>

	{snippets.length === 0 && <p class='no-results'>Nothing here yet.</p>}

	{
		snippets.map(({ id, data, Content }) => (
			<article class='snippet' id={id}>
				{(data.company || data.draft) && (
					<p class='kicker'>
						{data.draft && <span class='draft-badge'>Draft</span>}
						{data.company}
					</p>
				)}
				{data.title && <h2>{data.title}</h2>}
				<div class='post-content'>
					<span class='dateline'>
						<a href={`#${id}`} title='Link to this snippet'>
							<time datetime={data.pubDate.toISOString()}>
								{dateline(data.pubDate)}
							</time>
						</a>{' '}
						—
					</span>
					<Content />
				</div>
				<button
					class='snippet-toggle'
					type='button'
					aria-expanded='false'
					hidden
				>
					Continue reading
				</button>
			</article>
		))
	}

	<div
		class='ticker'
		id='ticker'
		role='region'
		aria-label='Market ticker, quotes delayed'
	>
		<div class='ticker-viewport'>
			<div class='ticker-track' id='ticker-track'></div>
		</div>
	</div>

	<script is:inline>
		// Collapse long snippets to a preview; expand on click
		;(() => {
			const setOpen = (snippet, open) => {
				snippet.classList.toggle('is-collapsed', !open)
				const toggle = snippet.querySelector('.snippet-toggle')
				toggle.setAttribute('aria-expanded', String(open))
				toggle.textContent = open ? 'Show less' : 'Continue reading'
			}

			for (const snippet of document.querySelectorAll('.snippet')) {
				const content = snippet.querySelector('.post-content')
				const toggle = snippet.querySelector('.snippet-toggle')
				snippet.classList.add('is-collapsed')
				// Short snippets fit in the preview, so leave them as they are
				if (content.scrollHeight <= content.clientHeight + 8) {
					snippet.classList.remove('is-collapsed')
					continue
				}
				toggle.hidden = false
				toggle.addEventListener('click', () => {
					const open = snippet.classList.contains('is-collapsed')
					setOpen(snippet, open)
					if (!open) snippet.scrollIntoView({ block: 'nearest' })
				})
				content.addEventListener('click', (e) => {
					if (
						snippet.classList.contains('is-collapsed') &&
						!e.target.closest('a')
					)
						setOpen(snippet, true)
				})
			}

			// A shared link to a snippet opens it
			const openTarget = () => {
				const target =
					location.hash && document.getElementById(location.hash.slice(1))
				if (target && target.classList.contains('is-collapsed'))
					setOpen(target, true)
			}
			openTarget()
			window.addEventListener('hashchange', openTarget)

			// Search every snippet's company, headline and text
			const searchBox = document.getElementById('search')
			const input = document.getElementById('snippet-search')
			const status = document.getElementById('search-status')
			const snippets = [...document.querySelectorAll('.snippet')]
			const searchable = (snippet) =>
				snippet.querySelectorAll('.kicker, h2, .post-content')

			const clearMarks = (snippet) => {
				for (const mark of snippet.querySelectorAll('mark.hit'))
					mark.replaceWith(mark.textContent)
				snippet.normalize()
			}

			const markMatches = (root, query) => {
				const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
				const nodes = []
				while (walker.nextNode()) nodes.push(walker.currentNode)
				for (const node of nodes) {
					const text = node.nodeValue
					const lower = text.toLowerCase()
					let i = lower.indexOf(query)
					if (i === -1) continue
					const frag = document.createDocumentFragment()
					let last = 0
					while (i !== -1) {
						frag.append(text.slice(last, i))
						const mark = document.createElement('mark')
						mark.className = 'hit'
						mark.textContent = text.slice(i, i + query.length)
						frag.append(mark)
						last = i + query.length
						i = lower.indexOf(query, last)
					}
					frag.append(text.slice(last))
					node.replaceWith(frag)
				}
			}

			const search = () => {
				const raw = input.value.trim()
				const query = raw.toLowerCase()
				let shown = 0
				for (const snippet of snippets) {
					clearMarks(snippet)
					const parts = searchable(snippet)
					const match =
						!query ||
						[...parts].some((el) =>
							el.textContent.toLowerCase().includes(query)
						)
					snippet.classList.toggle('is-hidden', !match)
					if (match) shown++

					if (query && match) {
						parts.forEach((el) => markMatches(el, query))
						// Open collapsed matches so the hits are visible
						if (snippet.classList.contains('is-collapsed')) {
							snippet.dataset.autoOpen = ''
							setOpen(snippet, true)
						}
					} else if (!query && 'autoOpen' in snippet.dataset) {
						delete snippet.dataset.autoOpen
						setOpen(snippet, false)
					}
				}
				status.hidden = !query
				status.textContent =
					shown === 0
						? `No snippets mention “${raw}”`
						: `${shown} ${shown === 1 ? 'snippet mentions' : 'snippets mention'} “${raw}”`
			}

			let timer
			input.addEventListener('input', () => {
				clearTimeout(timer)
				timer = setTimeout(search, 120)
			})
			input.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					input.value = ''
					search()
					input.blur()
				}
			})
			// Press / anywhere to jump to search
			document.addEventListener('keydown', (e) => {
				if (e.key === '/' && document.activeElement !== input) {
					e.preventDefault()
					input.focus()
				}
			})
			searchBox.hidden = false
		})()
		;(async () => {
			const ticker = document.getElementById('ticker')
			const track = document.getElementById('ticker-track')
			try {
				const res = await fetch('/api/quotes')
				const { quotes } = await res.json()
				if (!res.ok || !quotes.length) throw new Error('no quotes')

				const group = document.createElement('div')
				group.className = 'ticker-group'
				for (const q of quotes) {
					const up = q.change >= 0
					const item = document.createElement('span')
					item.className = 'ticker-item'

					const label = document.createElement('b')
					label.textContent = q.label
					const price = document.createElement('span')
					price.textContent = q.price.toLocaleString('en-US', {
						minimumFractionDigits: 2,
						maximumFractionDigits: 2
					})
					const change = document.createElement('span')
					change.className = up ? 'up' : 'down'
					change.textContent = `${up ? '▲' : '▼'} ${Math.abs(q.change).toFixed(2)}%`

					item.append(label, price, change)
					group.append(item)
				}

				// Two identical groups so the loop scrolls seamlessly
				const copy = group.cloneNode(true)
				copy.setAttribute('aria-hidden', 'true')
				track.replaceChildren(group, copy)
				track.style.setProperty('--duration', `${quotes.length * 5}s`)
				track.classList.add('is-running')
			} catch {
				ticker.remove()
			}
		})()
	</script>
</BaseLayout>

<style>
	/* ---------- Salmon paper tint, this page only ---------- */
	:global(html:has(.masthead)) {
		--bg-color: #fff1e5;
		--border-color: #ecd8c4;
	}

	:global(html[data-theme='dark']:has(.masthead)) {
		--bg-color: #1f1a17;
		--border-color: #3b322b;
	}

	/* ---------- Masthead: double rule, like a broadsheet ---------- */
	.masthead {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin: 0 0 2.5rem;
		padding: 0 0 0.6rem;
		border-bottom: 3px double var(--heading-color);
	}

	.masthead .page-title {
		margin: 0;
		text-align: left;
	}

	/* ---------- Search ---------- */
	.search {
		position: relative;
		display: flex;
		align-items: center;
		margin-bottom: 0.4rem;
	}

	.search[hidden] {
		display: none;
	}

	.search input {
		width: 15rem;
		padding: 0.3rem 1.8rem 0.3rem 0;
		border: none;
		border-bottom: 1px solid var(--border-color);
		border-radius: 0;
		background: transparent;
		font-family: 'EB Garamond', serif;
		font-size: 1rem;
		color: var(--heading-color);
		outline: none;
		appearance: none;
		transition: border-color 0.2s ease;
	}

	.search input::placeholder {
		font-style: italic;
		color: var(--link-hover-color);
	}

	.search input:focus {
		border-bottom-color: var(--heading-color);
	}

	.search input::-webkit-search-cancel-button {
		display: none;
	}

	.search kbd {
		position: absolute;
		right: 0;
		padding: 0 0.35em;
		border: 1px solid var(--border-color);
		border-radius: 3px;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		color: var(--link-hover-color);
		pointer-events: none;
	}

	.search input:focus + kbd,
	.search input:not(:placeholder-shown) + kbd {
		display: none;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.search-status {
		margin: -1.5rem 0 1.75rem;
		font-variant: small-caps;
		text-transform: lowercase;
		letter-spacing: 0.06em;
		color: var(--link-hover-color);
	}

	.snippet.is-hidden {
		display: none;
	}

	.snippet :global(mark.hit) {
		padding: 0 0.05em;
		border-radius: 2px;
		background: #f6cfa3;
		color: inherit;
	}

	:global([data-theme='dark']) .snippet :global(mark.hit) {
		background: #6b4a2c;
	}

	@media (max-width: 600px) {
		.search,
		.search input {
			width: 100%;
		}
	}

	/* ---------- Snippets ---------- */
	.snippet {
		scroll-margin-top: 2rem;
	}

	/* Rule between visible snippets, so filtering doesn't leave a stray line on top */
	.snippet:not(.is-hidden) ~ .snippet:not(.is-hidden) {
		margin-top: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-color);
	}

	/* Collapsed preview: about five lines, fading out */
	.snippet.is-collapsed .post-content {
		max-height: 9em;
		overflow: hidden;
		cursor: pointer;
		mask-image: linear-gradient(to bottom, #000 45%, transparent);
	}

	.snippet-toggle {
		margin-top: 0.4rem;
		padding: 0;
		border: none;
		background: none;
		font-family: 'EB Garamond', serif;
		font-size: 0.95em;
		font-variant: small-caps;
		text-transform: lowercase;
		letter-spacing: 0.06em;
		color: var(--link-color);
		cursor: pointer;
	}

	.snippet-toggle::after {
		content: ' ↓';
	}

	.snippet-toggle[aria-expanded='true']::after {
		content: ' ↑';
	}

	.snippet-toggle:hover {
		color: var(--heading-color);
	}

	/* Section-label style company name above the headline */
	.kicker {
		margin: 0 0 0.1rem;
		font-size: 0.85em;
		font-variant: small-caps;
		text-transform: lowercase;
		letter-spacing: 0.1em;
		color: var(--link-hover-color);
	}

	/* Only visible in local dev, where drafts are shown */
	.draft-badge {
		margin-right: 0.5em;
		padding: 0 0.35em;
		border: 1px solid currentColor;
		border-radius: 3px;
		color: #b42318;
	}

	.snippet h2 {
		margin: 0 0 0.5rem;
		font-size: 1.4em;
	}

	.snippet .post-content {
		/* Contains the floated dateline */
		display: flow-root;
		/* Lining, equal-width figures, like a financial table */
		font-variant-numeric: lining-nums tabular-nums;
	}

	/* Dateline floats so the first line of text runs straight on from it */
	.dateline {
		float: left;
		margin-right: 0.35em;
		color: var(--link-hover-color);
	}

	.dateline a {
		font-variant: small-caps;
		text-transform: lowercase;
		letter-spacing: 0.06em;
		color: inherit;
		text-decoration: none;
	}

	.dateline a:hover,
	.snippet:target .dateline a {
		color: var(--heading-color);
	}

	.snippet .dateline + :global(*) {
		margin-top: 0;
	}

	/* ---------- Ticker, pinned to the bottom of the window ---------- */
	.ticker {
		--up: #1a7f37;
		--down: #b42318;
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		height: 2.5rem;
		background: var(--bg-color);
		border-top: 1px solid var(--border-color);
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
	}

	:global([data-theme='dark']) .ticker {
		--up: #4caf6e;
		--down: #e5534b;
	}

	/* Leave room for the ticker under the footer and theme button */
	:global(body:has(#ticker)) {
		padding-bottom: 2.5rem;
	}

	:global(body:has(#ticker) #theme-toggle) {
		bottom: calc(30px + 2.5rem);
	}

	.ticker-viewport {
		flex: 1;
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 3rem,
			#000 calc(100% - 3rem),
			transparent
		);
	}

	.ticker-track {
		display: flex;
		width: max-content;
	}

	.ticker-track.is-running {
		animation: ticker-scroll var(--duration, 90s) linear infinite;
	}

	.ticker:hover .ticker-track {
		animation-play-state: paused;
	}

	.ticker-track :global(.ticker-group) {
		display: flex;
	}

	.ticker-track :global(.ticker-item) {
		display: inline-flex;
		gap: 0.5rem;
		padding: 0 1.4rem;
		white-space: nowrap;
		color: var(--link-color);
	}

	.ticker-track :global(.ticker-item b) {
		font-weight: 500;
		color: var(--heading-color);
	}

	.ticker-track :global(.up) {
		color: var(--up);
	}

	.ticker-track :global(.down) {
		color: var(--down);
	}

	@keyframes ticker-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ticker-track.is-running {
			animation: none;
		}

		.ticker-viewport {
			overflow-x: auto;
		}
	}
</style>
